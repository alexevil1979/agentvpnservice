# Copy to /ssd/www/agentvpnservice/.env on the host. Never commit real values.

PUBLIC_BASE_URL=https://agentvpnservice.1tlt.ru
BIND_HOST=127.0.0.1
BIND_PORT=8091

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-long-random

INCIDENT_WEBHOOK_TOKEN=change-me-webhook-token

PORTIX_API_KEY=
PORTIX_BASE_URL=https://www.portixapi.com/v1
PORTIX_MODEL=grok-4.7

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Comma-separated local SOCKS ports on the jump host
SOCKS_PORTS=1080,1081,1082,1083,1084,1085
SOCKS_PREFERRED=

DRY_RUN=1
APPROVAL_TIMEOUT_MINUTES=60
REMINDER_MINUTES=15

INVENTORY_PATH=/ssd/www/agentvpnservice/inventory.yml
DATA_DIR=/ssd/www/agentvpnservice/data
SCRIPTS_DIR=/ssd/www/agentvpnservice/scripts

# SSH secrets: set env vars named in inventory auth.*_env fields
# Example: SSH_PASSWORD_VPN_FI_1=...
# Example: HIDDIFY_SSH_KEY_PATH=/root/.ssh/id_ed25519
